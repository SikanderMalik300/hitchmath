# Cloudflare Pages environment variables (A1)
NODE_VERSION=22
# Web3Forms access key for the contact form
NEXT_PUBLIC_WEB3FORMS_KEY=
# Google Analytics 4 id. GA loads ONLY when this is set.
NEXT_PUBLIC_GA_ID=
# AdSense client id. Ad slots render nothing until this is set (A10).
NEXT_PUBLIC_ADSENSE_ID=
